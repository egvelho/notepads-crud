generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgres"
}

model User {
  id       Int       @id @default(autoincrement())
  username String    @unique
  password String
  notepads Notepad[]
}

model Notepad {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  userId      Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}